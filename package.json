{
  "name": "zimmar-accessibility-compliance-checker",
  "description": "A Figma plugin that checks for accessibility compliance issues within designs and helps you fix them.",
  "author": {
    "name": "Josh Praise",
    "email": "praizjosh@outlook.com"
  },
  "license": "MIT",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "commit": "commit",
    "dev": "npm run start",
    "build": "tsc -b && vite build --emptyOutDir=false && npm run build:main",
    "build:main": "esbuild plugin/code.ts --bundle --outfile=dist/code.js",
    "build:main:watch": "esbuild plugin/code.ts --bundle --outfile=dist/code.js --watch",
    "build:ui:watch": "vite build --watch --emptyOutDir=false",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0 --no-warn-ignored",
    "lint:debug": "eslint --ext .jsx,.js,.ts,.tsx ./src --debug --max-warnings=0",
    "lint:fix": "npx eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --max-warnings=0 --no-warn-ignored",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "concurrently -n tsc,build,ui -c yellow,blue,green \"npm run tsc:watch\" \"npm run build:main:watch\" \"npm run build:ui:watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc:watch": "tsc -b --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@create-figma-plugin/utilities": "^4.0.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "apca-w3": "^0.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.475.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "wcag-contrast": "^3.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/prompt-cli": "^19.8.1",
    "@eslint/js": "^9.19.0",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.107.0-beta.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/apca-w3": "^0.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@types/wcag-contrast": "^3.0.3",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npm run lint:fix",
      "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" --config ./.prettierrc"
    ]
  }
}
